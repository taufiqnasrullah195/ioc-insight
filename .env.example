# =============================================================================
# IOC Insight — Environment Variables (.env example)
# =============================================================================
# Cara pakai:
#   cp .env.example .env     → lalu isi nilai-nilai di bawah
#   set -a && source .env && set +a     → load ke shell session
#
# PENTING: file .env JANGAN pernah di-commit (sudah ada di .gitignore).
# config.yaml membaca nilai lewat pola "ENV:NAMA_VARIABEL" — jadi yang
# disimpan di config hanya NAMA variabelnya, bukan secret-nya.
# =============================================================================

# --- Threat Intelligence API keys (semua GRATIS, daftar 5 menit per situs) ---

# VirusTotal — https://www.virustotal.com/gui/my-apikey
#   Free tier: 4 request/menit, 500/hari. Dipakai untuk: IP, domain, URL, hash.
VT_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/account/api
#   Free tier: 1.000 check/hari. Dipakai untuk: IP saja (IPv4/IPv6).
ABUSEIPDB_API_KEY=

# AlienVault OTX — https://otx.alienvault.com/api  (Settings → API Integration)
#   Free, quota longgar. Dipakai untuk: IP, domain, URL, hash (pulse count).
OTX_API_KEY=

# urlscan.io — https://urlscan.io/user/signup  → Profile → API
#   Free. Dipakai untuk: URL & domain (riwayat scan + verdict).
URLSCAN_API_KEY=

# GreyNoise — https://viz.greynoise.io/signup  → Account → API Key
#   Free "community" tier. Dipakai untuk: IP — membedakan internet noise vs serangan.
GREYNOISE_API_KEY=

# abuse.ch (ThreatFox + URLhaus + MalwareBazaar) — https://auth.abuse.ch/
#   SATU key gratis membuka ketiganya. Dipakai untuk: IP, domain, URL, hash.
ABUSECH_AUTH_KEY=

# --- Notifikasi Telegram (opsional) ---
# Buat bot via @BotFather → dapat token. Jadikan bot admin di channel Anda,
# kirim pesan di channel, lalu ambil chat_id dari:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Aktifkan juga di config.yaml:  notify: { enabled: true }
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WHOIS domain age — TIDAK butuh key. Selalu aktif untuk tipe domain.

# --- AI provider (OpenAI-compatible) ---
# Default mengikuti konfigurasi Hermes Anda (api.vleee.net, model ali/kimi-k3).
# Variabel ini yang direferensikan config.yaml di key "ai.api_key".
HERMES_CUSTOM_API_VLEEE_NET_API_KEY=

# --- Opsional: ganti AI provider tanpa edit config.yaml ---
# Kalau mau pakai provider/model lain (misalnya OpenRouter, atau model
# non-reasoning yang lebih cepat), cukup edit config.yaml bagian `ai:` —
# tidak ada variabel env tambahan yang diperlukan.
